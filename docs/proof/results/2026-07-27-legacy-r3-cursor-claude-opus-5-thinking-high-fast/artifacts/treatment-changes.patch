+import { describe, expect, it } from 'vitest';
+import type { Todo } from '../types';
+import { filterTodos, matchesQuery, matchesStatus } from './todoFilter';
+
+const todos: Todo[] = [
+  { id: '1', title: 'Write the spec', completed: false },
+  { id: '2', title: 'Write the release notes', completed: true },
+  { id: '3', title: 'Ship the update', completed: false },
+];
+
+describe('matchesQuery', () => {
+  it('matches regardless of case', () => {
+    expect(matchesQuery('Write the spec', 'WRITE')).toBe(true);
+    expect(matchesQuery('WRITE THE SPEC', 'write')).toBe(true);
+  });
+
+  it('matches anywhere in the title, not just the start', () => {
+    expect(matchesQuery('Write the spec', 'the spec')).toBe(true);
+  });
+
+  it('rejects titles that do not contain the query', () => {
+    expect(matchesQuery('Write the spec', 'ship')).toBe(false);
+  });
+
+  it('treats a blank query as no filter', () => {
+    expect(matchesQuery('Write the spec', '')).toBe(true);
+    expect(matchesQuery('Write the spec', '   ')).toBe(true);
+  });
+
+  it('ignores surrounding whitespace in the query', () => {
+    expect(matchesQuery('Write the spec', '  spec  ')).toBe(true);
+  });
+});
+
+describe('matchesStatus', () => {
+  it('keeps everything for all', () => {
+    expect(matchesStatus(todos[0], 'all')).toBe(true);
+    expect(matchesStatus(todos[1], 'all')).toBe(true);
+  });
+
+  it('splits active from completed', () => {
+    expect(matchesStatus(todos[0], 'active')).toBe(true);
+    expect(matchesStatus(todos[1], 'active')).toBe(false);
+    expect(matchesStatus(todos[0], 'completed')).toBe(false);
+    expect(matchesStatus(todos[1], 'completed')).toBe(true);
+  });
+});
+
+describe('filterTodos', () => {
+  it('returns every todo when the status is all and the query is blank', () => {
+    expect(filterTodos(todos, 'all', '')).toEqual(todos);
+  });
+
+  it('combines the query with the status filter', () => {
+    expect(filterTodos(todos, 'active', 'write').map((todo) => todo.id)).toEqual(['1']);
+    expect(filterTodos(todos, 'completed', 'write').map((todo) => todo.id)).toEqual(['2']);
+    expect(filterTodos(todos, 'all', 'write').map((todo) => todo.id)).toEqual(['1', '2']);
+  });
+
+  it('returns nothing when the query matches no title', () => {
+    expect(filterTodos(todos, 'all', 'nothing here')).toEqual([]);
+  });
+
+  it('does not mutate the input', () => {
+    const input = todos.map((todo) => ({ ...todo }));
+    filterTodos(input, 'active', 'write');
+    expect(input).toEqual(todos);
+  });
+});
