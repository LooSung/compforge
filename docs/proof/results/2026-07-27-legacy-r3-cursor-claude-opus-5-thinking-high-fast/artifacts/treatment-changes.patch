+import { act, renderHook } from '@testing-library/react';
+import { describe, expect, it } from 'vitest';
+import { useTodoSearchQuery } from './useTodoSearchQuery';
+
+describe('useTodoSearchQuery', () => {
+  it('reads the query already in the URL', () => {
+    window.history.replaceState(null, '', '?q=spec');
+
+    const { result } = renderHook(() => useTodoSearchQuery());
+
+    expect(result.current.query).toBe('spec');
+  });
+
+  it('defaults to an empty query when the URL has none', () => {
+    const { result } = renderHook(() => useTodoSearchQuery());
+
+    expect(result.current.query).toBe('');
+  });
+
+  it('writes the query to the URL without pushing history entries', () => {
+    const lengthBefore = window.history.length;
+    const { result } = renderHook(() => useTodoSearchQuery());
+
+    act(() => result.current.setQuery('release notes'));
+
+    expect(new URLSearchParams(window.location.search).get('q')).toBe('release notes');
+    expect(result.current.query).toBe('release notes');
+    expect(window.history.length).toBe(lengthBefore);
+  });
+
+  it('drops the parameter when the query is cleared', () => {
+    window.history.replaceState(null, '', '?q=spec');
+    const { result } = renderHook(() => useTodoSearchQuery());
+
+    act(() => result.current.setQuery(''));
+
+    expect(window.location.search).toBe('');
+    expect(result.current.query).toBe('');
+  });
+
+  it('preserves unrelated search params', () => {
+    window.history.replaceState(null, '', '?sort=title');
+    const { result } = renderHook(() => useTodoSearchQuery());
+
+    act(() => result.current.setQuery('spec'));
+
+    const params = new URLSearchParams(window.location.search);
+    expect(params.get('sort')).toBe('title');
+    expect(params.get('q')).toBe('spec');
+  });
+
+  it('follows back/forward navigation', () => {
+    const { result } = renderHook(() => useTodoSearchQuery());
+
+    act(() => {
+      window.history.replaceState(null, '', '?q=ship');
+      window.dispatchEvent(new PopStateEvent('popstate'));
+    });
+
+    expect(result.current.query).toBe('ship');
+  });
+});
diff --git a/src/hooks/useTodoSearchQuery.ts b/src/hooks/useTodoSearchQuery.ts
new file mode 100644
index 0000000..ba090e1
--- /dev/null
+++ b/src/hooks/useTodoSearchQuery.ts
@@ -0,0 +1,41 @@
+import { useCallback, useSyncExternalStore } from 'react';
+
+const QUERY_PARAM = 'q';
+
+// replaceState does not fire popstate, so writers notify subscribers directly.
+const listeners = new Set<() => void>();
+
+function subscribe(listener: () => void): () => void {
+  listeners.add(listener);
+  window.addEventListener('popstate', listener);
+  return () => {
+    listeners.delete(listener);
+    window.removeEventListener('popstate', listener);
+  };
+}
+
+function readQuery(): string {
+  return new URLSearchParams(window.location.search).get(QUERY_PARAM) ?? '';
+}
+
+function writeQuery(next: string): void {
+  const params = new URLSearchParams(window.location.search);
+  if (next.length === 0) {
+    params.delete(QUERY_PARAM);
+  } else {
+    params.set(QUERY_PARAM, next);
+  }
+  const search = params.toString();
+  window.history.replaceState(
+    null,
+    '',
+    search.length > 0 ? `${window.location.pathname}?${search}` : window.location.pathname,
+  );
+  for (const listener of listeners) listener();
+}
+
+export function useTodoSearchQuery(): { query: string; setQuery: (next: string) => void } {
+  const query = useSyncExternalStore(subscribe, readQuery);
+  const setQuery = useCallback((next: string) => writeQuery(next), []);
+  return { query, setQuery };
+}
