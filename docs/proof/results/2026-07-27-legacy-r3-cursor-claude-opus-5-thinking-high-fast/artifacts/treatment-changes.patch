+import type { Todo, TodoStatus } from '../types';
+
+export function matchesQuery(title: string, query: string): boolean {
+  const needle = query.trim().toLowerCase();
+  if (needle.length === 0) return true;
+  return title.toLowerCase().includes(needle);
+}
+
+export function matchesStatus(todo: Todo, status: TodoStatus): boolean {
+  if (status === 'active') return !todo.completed;
+  if (status === 'completed') return todo.completed;
+  return true;
+}
+
+export function filterTodos(todos: Todo[], status: TodoStatus, query: string): Todo[] {
+  return todos.filter(
+    (todo) => matchesStatus(todo, status) && matchesQuery(todo.title, query),
+  );
+}
