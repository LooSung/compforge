+++ b/src/utils/todoFilter.test.ts
@@ -0,0 +1,76 @@
+import { describe, expect, it } from 'vitest';
+import type { Todo } from '../types';
+import { matchesQuery, selectMatchingTodos } from './todoFilter';
+
+const todos: Todo[] = [
+  { id: '1', title: 'Write the spec', completed: false },
+  { id: '2', title: 'Ship the release', completed: true },
+  { id: '3', title: 'Review the SPEC again', completed: true },
+];
+
+const titles = (result: Todo[]) => result.map((todo) => todo.title);
+
+describe('matchesQuery', () => {
+  it('matches anywhere in the title, ignoring case', () => {
+    expect(matchesQuery('Write the spec', 'SPEC')).toBe(true);
+    expect(matchesQuery('Review the SPEC again', 'spec')).toBe(true);
+    expect(matchesQuery('Write the spec', 'write')).toBe(true);
+    expect(matchesQuery('Write the spec', 'the spec')).toBe(true);
+  });
+
+  it('does not match a title without the query', () => {
+    expect(matchesQuery('Ship the release', 'spec')).toBe(false);
+  });
+
+  it('treats a blank query as matching everything', () => {
+    expect(matchesQuery('Ship the release', '')).toBe(true);
+    expect(matchesQuery('Ship the release', '   ')).toBe(true);
+  });
+
+  it('ignores surrounding whitespace in the query', () => {
+    expect(matchesQuery('Write the spec', '  spec  ')).toBe(true);
+  });
+});
+
+describe('selectMatchingTodos', () => {
+  it('returns everything for the all filter and a blank query', () => {
+    expect(titles(selectMatchingTodos(todos, 'all', ''))).toEqual([
+      'Write the spec',
+      'Ship the release',
+      'Review the SPEC again',
+    ]);
+  });
+
+  it('keeps the source order of the matches', () => {
+    expect(titles(selectMatchingTodos(todos, 'all', 'spec'))).toEqual([
+      'Write the spec',
+      'Review the SPEC again',
+    ]);
+  });
+
+  it('combines the query with the active filter', () => {
+    expect(titles(selectMatchingTodos(todos, 'active', 'spec'))).toEqual([
+      'Write the spec',
+    ]);
+  });
+
+  it('combines the query with the completed filter', () => {
+    expect(titles(selectMatchingTodos(todos, 'completed', 'spec'))).toEqual([
+      'Review the SPEC again',
+    ]);
+  });
+
+  it('returns nothing when the query matches no title', () => {
+    expect(selectMatchingTodos(todos, 'all', 'nonsense')).toEqual([]);
+  });
+
+  it('returns nothing when the query matches only todos the filter excludes', () => {
+    expect(selectMatchingTodos(todos, 'active', 'release')).toEqual([]);
+  });
+
+  it('does not mutate the input', () => {
+    const input = [...todos];
+    selectMatchingTodos(input, 'completed', 'spec');
+    expect(input).toEqual(todos);
+  });
+});
diff --git a/src/utils/todoFilter.ts b/src/utils/todoFilter.ts
new file mode 100644
index 0000000..2b6e168
--- /dev/null
+++ b/src/utils/todoFilter.ts
@@ -0,0 +1,27 @@
+import type { Todo } from '../types';
+
+export const STATUS_FILTERS = ['all', 'active', 'completed'] as const;
+
+export type StatusFilter = (typeof STATUS_FILTERS)[number];
+
+export function matchesQuery(title: string, query: string): boolean {
+  const needle = query.trim().toLowerCase();
+  if (needle.length === 0) return true;
+  return title.toLowerCase().includes(needle);
+}
+
+export function matchesStatus(todo: Todo, filter: StatusFilter): boolean {
+  if (filter === 'active') return !todo.completed;
+  if (filter === 'completed') return todo.completed;
+  return true;
+}
+
+export function selectMatchingTodos(
+  todos: Todo[],
+  filter: StatusFilter,
+  query: string,
+): Todo[] {
+  return todos.filter(
+    (todo) => matchesStatus(todo, filter) && matchesQuery(todo.title, query),
+  );
+}
