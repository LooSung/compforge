@@ -0,0 +1,10 @@
+import { useSearchParamState } from '../../../shared/lib/useSearchParamState';
+
+// A search query is shareable and must survive reload, so its home is the URL.
+// Deferred: useSearchParamState pushes a history entry per change, so typing
+// leaves one entry per keystroke. Upgrade path is a replace option on that hook.
+export function useTodoSearch() {
+  const [query, setQuery] = useSearchParamState('q', '');
+
+  return { query, setQuery };
+}
