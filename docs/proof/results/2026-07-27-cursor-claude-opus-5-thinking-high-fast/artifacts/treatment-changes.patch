+  });
+
+  it('restores a shared URL of query plus status filter on load', async () => {
+    window.history.replaceState(null, '', '?q=alpha&filter=active');
+    renderApp();
+
+    expect(await screen.findByText('Alpha task')).toBeInTheDocument();
+    expect(screen.queryByText('alpha done')).not.toBeInTheDocument();
+    expect(screen.queryByText('beta task')).not.toBeInTheDocument();
+    expect(searchBox()).toHaveValue('alpha');
+  });
+
+  it('announces how many todos match', async () => {
+    const user = userEvent.setup();
+    renderApp();
+    await screen.findByText('3 matching');
+
+    await user.type(searchBox(), 'alpha');
+
+    const count = await screen.findByText('2 matching');
+    expect(count).toHaveAttribute('role', 'status');
+  });
+
+  it('shows a distinct empty state when the query matches nothing', async () => {
+    const user = userEvent.setup();
+    renderApp();
+    await screen.findByText('beta task');
+
+    await user.type(searchBox(), 'gamma');
+
+    expect(await screen.findByText(/no todos match “gamma”/i)).toBeInTheDocument();
+    expect(screen.queryByText(/no todos yet/i)).not.toBeInTheDocument();
+    expect(screen.getByText('0 matching')).toBeInTheDocument();
+    expect(
+      screen.getByRole('button', { name: /complete all matches/i }),
+    ).toBeDisabled();
+  });
+
+  it('completes every match and leaves non-matching todos alone', async () => {
+    const user = userEvent.setup();
+    renderApp();
+    await screen.findByText('beta task');
+
+    await user.type(searchBox(), 'alpha');
+    await user.click(screen.getByRole('button', { name: /complete all matches/i }));
+
+    await waitFor(() =>
+      expect(screen.getByRole('checkbox', { name: 'Alpha task' })).toBeChecked(),
+    );
+    expect(screen.getByRole('checkbox', { name: 'alpha done' })).toBeChecked();
+
+    await user.clear(searchBox());
+
+    expect(await screen.findByText('beta task')).toBeInTheDocument();
+    expect(screen.getByRole('checkbox', { name: 'beta task' })).not.toBeChecked();
+  });
+});
