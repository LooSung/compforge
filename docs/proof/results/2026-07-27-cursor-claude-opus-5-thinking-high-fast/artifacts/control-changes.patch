+export function matchesQuery(todo: Todo, query: string): boolean {
+  const needle = query.trim().toLowerCase();
+  if (!needle) return true;
+  return todo.title.toLowerCase().includes(needle);
+}
+
+export function searchTodos(todos: Todo[], query: string): Todo[] {
+  if (!query.trim()) return todos;
+  return todos.filter((todo) => matchesQuery(todo, query));
+}
+
+// Status and query narrow the same list, so the view asks for both at once
+// rather than stacking the two selectors at every call site.
+export function selectVisibleTodos(
+  todos: Todo[],
+  filter: TodoFilter,
+  query: string,
+): Todo[] {
+  return searchTodos(filterTodos(todos, filter), query);
+}
+
 export function countActive(todos: Todo[]): number {
   return todos.filter((todo) => !todo.completed).length;
 }
