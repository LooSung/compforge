@@ -0,0 +1,27 @@
+interface TodoSearchProps {
+  value: string;
+  matchCount: number;
+  onChange: (next: string) => void;
+}
+
+function describeMatches(count: number): string {
+  return count === 1 ? '1 todo matches' : `${count} todos match`;
+}
+
+export function TodoSearch({ value, matchCount, onChange }: TodoSearchProps) {
+  return (
+    <div className="todo-search">
+      <label htmlFor="todo-search">Search todos</label>
+      <input
+        id="todo-search"
+        type="search"
+        value={value}
+        onChange={(event) => onChange(event.target.value)}
+        placeholder="Search by title"
+      />
+      {/* role="status" makes the count a polite live region, so screen readers
+          hear the result change without the input losing focus. */}
+      <p role="status">{describeMatches(matchCount)}</p>
+    </div>
+  );
+}
