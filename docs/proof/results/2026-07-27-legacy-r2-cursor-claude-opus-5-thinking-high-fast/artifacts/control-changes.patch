@@ -0,0 +1,45 @@
+import { describe, expect, it } from 'vitest';
+import { readQueryParam, writeQueryParam } from './url';
+
+describe('readQueryParam', () => {
+  it('returns an empty string when the param is absent', () => {
+    expect(readQueryParam('')).toBe('');
+    expect(readQueryParam('?filter=active')).toBe('');
+  });
+
+  it('reads the query param', () => {
+    expect(readQueryParam('?q=spec')).toBe('spec');
+  });
+
+  it('decodes escaped characters', () => {
+    expect(readQueryParam('?q=write%20the%20spec')).toBe('write the spec');
+  });
+});
+
+describe('writeQueryParam', () => {
+  it('adds the param', () => {
+    expect(writeQueryParam('', 'spec')).toBe('?q=spec');
+  });
+
+  it('replaces an existing value', () => {
+    expect(writeQueryParam('?q=old', 'new')).toBe('?q=new');
+  });
+
+  it('encodes special characters', () => {
+    expect(writeQueryParam('', 'write the spec')).toBe('?q=write+the+spec');
+  });
+
+  it('drops the param for an empty or blank query', () => {
+    expect(writeQueryParam('?q=spec', '')).toBe('');
+    expect(writeQueryParam('?q=spec', '   ')).toBe('');
+  });
+
+  it('keeps unrelated params intact', () => {
+    expect(writeQueryParam('?page=2', 'spec')).toBe('?page=2&q=spec');
+    expect(writeQueryParam('?page=2&q=spec', '')).toBe('?page=2');
+  });
+
+  it('round-trips through readQueryParam', () => {
+    expect(readQueryParam(writeQueryParam('', 'Spec & Design'))).toBe('Spec & Design');
+  });
+});
