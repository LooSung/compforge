+import { describe, expect, it } from 'vitest';
+import type { Todo } from '../types';
+import {
+  matchesFilter,
+  matchesQuery,
+  normalizeQuery,
+  selectMatchingTodos,
+} from './search';
+
+const todo = (overrides: Partial<Todo> = {}): Todo => ({
+  id: '1',
+  title: 'Write the spec',
+  completed: false,
+  ...overrides,
+});
+
+const TODOS: Todo[] = [
+  { id: '1', title: 'Write the spec', completed: false },
+  { id: '2', title: 'Ship the release', completed: true },
+  { id: '3', title: 'Review SPEC feedback', completed: true },
+  { id: '4', title: 'Book the venue', completed: false },
+];
+
+const titles = (todos: Todo[]) => todos.map((item) => item.title);
+
+describe('normalizeQuery', () => {
+  it('trims and lowercases', () => {
+    expect(normalizeQuery('  SpEc  ')).toBe('spec');
+  });
+
+  it('collapses whitespace-only input to empty', () => {
+    expect(normalizeQuery('   ')).toBe('');
+  });
+});
+
+describe('matchesQuery', () => {
+  it('matches every todo for an empty query', () => {
+    expect(matchesQuery(todo(), '')).toBe(true);
+    expect(matchesQuery(todo(), '   ')).toBe(true);
+  });
+
+  it('matches a substring of the title', () => {
+    expect(matchesQuery(todo(), 'the')).toBe(true);
+    expect(matchesQuery(todo(), 'Write the spec')).toBe(true);
+  });
+
+  it('ignores case on both sides', () => {
+    expect(matchesQuery(todo({ title: 'Write the SPEC' }), 'spec')).toBe(true);
+    expect(matchesQuery(todo({ title: 'write the spec' }), 'SPEC')).toBe(true);
+  });
+
+  it('ignores surrounding whitespace in the query', () => {
+    expect(matchesQuery(todo(), '  spec  ')).toBe(true);
+  });
+
+  it('rejects titles that do not contain the query', () => {
+    expect(matchesQuery(todo(), 'release')).toBe(false);
+  });
+
+  it('does not treat the query as a regular expression', () => {
+    expect(matchesQuery(todo({ title: 'Write the spec' }), 'w.ite')).toBe(false);
+    expect(matchesQuery(todo({ title: 'Cost is $5 (net)' }), '$5 (net)')).toBe(true);
+  });
+
+  it('matches on the title only, not the id', () => {
+    expect(matchesQuery(todo({ id: 'abc', title: 'Write the spec' }), 'abc')).toBe(
+      false,
+    );
+  });
+});
+
+describe('matchesFilter', () => {
+  it('accepts everything for "all"', () => {
+    expect(matchesFilter(todo({ completed: false }), 'all')).toBe(true);
+    expect(matchesFilter(todo({ completed: true }), 'all')).toBe(true);
+  });
+
+  it('accepts only incomplete todos for "active"', () => {
+    expect(matchesFilter(todo({ completed: false }), 'active')).toBe(true);
+    expect(matchesFilter(todo({ completed: true }), 'active')).toBe(false);
+  });
+
+  it('accepts only completed todos for "completed"', () => {
+    expect(matchesFilter(todo({ completed: false }), 'completed')).toBe(false);
+    expect(matchesFilter(todo({ completed: true }), 'completed')).toBe(true);
+  });
+});
+
+describe('selectMatchingTodos', () => {
+  it('returns everything when the filter is "all" and the query is empty', () => {
+    expect(selectMatchingTodos(TODOS, 'all', '')).toEqual(TODOS);
+  });
+
+  it('applies the query case-insensitively', () => {
+    expect(titles(selectMatchingTodos(TODOS, 'all', 'spec'))).toEqual([
+      'Write the spec',
+      'Review SPEC feedback',
+    ]);
+  });
+
+  it('combines the query with the active filter', () => {
+    expect(titles(selectMatchingTodos(TODOS, 'active', 'spec'))).toEqual([
+      'Write the spec',
+    ]);
+  });
+
+  it('combines the query with the completed filter', () => {
+    expect(titles(selectMatchingTodos(TODOS, 'completed', 'spec'))).toEqual([
+      'Review SPEC feedback',
+    ]);
+  });
+
+  it('returns nothing when the query matches no title', () => {
+    expect(selectMatchingTodos(TODOS, 'all', 'nothing here')).toEqual([]);
+  });
+
+  it('returns nothing when the query matches but the filter excludes it', () => {
+    expect(selectMatchingTodos(TODOS, 'completed', 'venue')).toEqual([]);
+  });
+
+  it('preserves the original order', () => {
+    expect(titles(selectMatchingTodos(TODOS, 'all', 'the'))).toEqual([
+      'Write the spec',
+      'Ship the release',
+      'Book the venue',
+    ]);
+  });
+
+  it('does not mutate the input', () => {
+    const input = [...TODOS];
+    selectMatchingTodos(input, 'active', 'spec');
+    expect(input).toEqual(TODOS);
+  });
+});
diff --git a/src/utils/search.ts b/src/utils/search.ts
new file mode 100644
index 0000000..6f5be09
--- /dev/null
+++ b/src/utils/search.ts
@@ -0,0 +1,27 @@
+import type { Filter, Todo } from '../types';
+
+export function normalizeQuery(query: string): string {
+  return query.trim().toLowerCase();
+}
+
+export function matchesQuery(todo: Todo, query: string): boolean {
+  const needle = normalizeQuery(query);
+  if (needle.length === 0) return true;
+  return todo.title.toLowerCase().includes(needle);
+}
+
+export function matchesFilter(todo: Todo, filter: Filter): boolean {
+  if (filter === 'active') return !todo.completed;
+  if (filter === 'completed') return todo.completed;
+  return true;
+}
+
+export function selectMatchingTodos(
+  todos: Todo[],
+  filter: Filter,
+  query: string,
+): Todo[] {
+  return todos.filter(
+    (todo) => matchesFilter(todo, filter) && matchesQuery(todo, query),
+  );
+}
