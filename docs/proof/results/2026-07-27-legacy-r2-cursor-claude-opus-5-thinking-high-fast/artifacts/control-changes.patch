+export const QUERY_PARAM = 'q';
+
+export function readQueryParam(search: string): string {
+  return new URLSearchParams(search).get(QUERY_PARAM) ?? '';
+}
+
+/** Returns the `?...` string (empty when no params remain) for the given query. */
+export function writeQueryParam(search: string, query: string): string {
+  const params = new URLSearchParams(search);
+  if (query.trim().length === 0) {
+    params.delete(QUERY_PARAM);
+  } else {
+    params.set(QUERY_PARAM, query);
+  }
+  const serialized = params.toString();
+  return serialized.length === 0 ? '' : `?${serialized}`;
+}
