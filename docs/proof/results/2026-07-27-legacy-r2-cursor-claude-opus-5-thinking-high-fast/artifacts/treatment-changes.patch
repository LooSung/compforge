+++ b/src/utils/todoFilters.ts
@@ -0,0 +1,29 @@
+import type { Todo } from '../types';
+
+export const TODO_FILTERS = ['all', 'active', 'completed'] as const;
+
+export type TodoFilter = (typeof TODO_FILTERS)[number];
+
+export function normalizeQuery(query: string): string {
+  return query.trim().toLowerCase();
+}
+
+export function matchesQuery(todo: Todo, query: string): boolean {
+  const needle = normalizeQuery(query);
+  if (needle.length === 0) return true;
+  return todo.title.toLowerCase().includes(needle);
+}
+
+export function matchesFilter(todo: Todo, filter: TodoFilter): boolean {
+  if (filter === 'active') return !todo.completed;
+  if (filter === 'completed') return todo.completed;
+  return true;
+}
+
+export function selectVisibleTodos(
+  todos: Todo[],
+  filter: TodoFilter,
+  query: string,
+): Todo[] {
+  return todos.filter((todo) => matchesFilter(todo, filter) && matchesQuery(todo, query));
+}
