+import { act, renderHook } from '@testing-library/react';
+import { afterEach, describe, expect, it } from 'vitest';
+import { useUrlParam } from './useUrlParam';
+
+function setUrl(url: string): void {
+  window.history.replaceState(null, '', url);
+}
+
+afterEach(() => {
+  setUrl('/');
+});
+
+describe('useUrlParam', () => {
+  it('reads the initial value from the URL', () => {
+    setUrl('/?q=spec');
+
+    const { result } = renderHook(() => useUrlParam('q'));
+
+    expect(result.current.value).toBe('spec');
+  });
+
+  it('returns an empty string when the param is absent', () => {
+    const { result } = renderHook(() => useUrlParam('q'));
+
+    expect(result.current.value).toBe('');
+  });
+
+  it('writes the value into the URL without pushing history entries', () => {
+    const { result } = renderHook(() => useUrlParam('q'));
+    const lengthBefore = window.history.length;
+
+    act(() => result.current.setValue('spec'));
+
+    expect(new URLSearchParams(window.location.search).get('q')).toBe('spec');
+    expect(result.current.value).toBe('spec');
+    expect(window.history.length).toBe(lengthBefore);
+  });
+
+  it('removes the param when the value is cleared', () => {
+    setUrl('/?q=spec&filter=active');
+    const { result } = renderHook(() => useUrlParam('q'));
+
+    act(() => result.current.setValue(''));
+
+    expect(window.location.search).toBe('?filter=active');
+    expect(result.current.value).toBe('');
+  });
+
+  it('leaves other params alone', () => {
+    setUrl('/?filter=active');
+    const { result } = renderHook(() => useUrlParam('q'));
+
+    act(() => result.current.setValue('spec'));
+
+    const params = new URLSearchParams(window.location.search);
+    expect(params.get('filter')).toBe('active');
+    expect(params.get('q')).toBe('spec');
+  });
+
+  it('resyncs when the browser navigates', () => {
+    const { result } = renderHook(() => useUrlParam('q'));
+
+    act(() => {
+      setUrl('/?q=release');
+      window.dispatchEvent(new PopStateEvent('popstate'));
+    });
+
+    expect(result.current.value).toBe('release');
+  });
+
+  it('stops listening after unmount', () => {
+    const { result, unmount } = renderHook(() => useUrlParam('q'));
+
+    unmount();
+
+    expect(() => {
+      setUrl('/?q=release');
+      window.dispatchEvent(new PopStateEvent('popstate'));
+    }).not.toThrow();
+    expect(result.current.value).toBe('');
+  });
+});
diff --git a/src/hooks/useUrlParam.ts b/src/hooks/useUrlParam.ts
new file mode 100644
index 0000000..0a15257
--- /dev/null
+++ b/src/hooks/useUrlParam.ts
@@ -0,0 +1,52 @@
+import { useCallback, useSyncExternalStore } from 'react';
+
+// history.pushState/replaceState do not fire popstate, so same-document updates
+// announce themselves on this event instead.
+const URL_CHANGED = 'todo:urlchange';
+
+function subscribe(onStoreChange: () => void): () => void {
+  window.addEventListener('popstate', onStoreChange);
+  window.addEventListener(URL_CHANGED, onStoreChange);
+  return () => {
+    window.removeEventListener('popstate', onStoreChange);
+    window.removeEventListener(URL_CHANGED, onStoreChange);
+  };
+}
+
+function readParam(key: string): string {
+  return new URLSearchParams(window.location.search).get(key) ?? '';
+}
+
+/**
+ * Reads and writes a single URL search param so the value survives reload and can
+ * be shared as a link. Writes replace the current entry rather than pushing one,
+ * so per-keystroke edits do not fill the back stack.
+ */
+export function useUrlParam(key: string): {
+  value: string;
+  setValue: (next: string) => void;
+} {
+  const value = useSyncExternalStore(
+    subscribe,
+    () => readParam(key),
+    () => '',
+  );
+
+  const setValue = useCallback(
+    (next: string) => {
+      const params = new URLSearchParams(window.location.search);
+      if (next.length === 0) {
+        params.delete(key);
+      } else {
+        params.set(key, next);
+      }
+      const search = params.toString();
+      const url = `${window.location.pathname}${search ? `?${search}` : ''}${window.location.hash}`;
+      window.history.replaceState(window.history.state, '', url);
+      window.dispatchEvent(new Event(URL_CHANGED));
+    },
+    [key],
+  );
+
+  return { value, setValue };
+}
