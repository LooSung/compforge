+import { describe, expect, it } from 'vitest';
+import type { Todo } from '../types';
+import { matchesFilter, matchesQuery, selectVisibleTodos } from './todoFilters';
+
+const todos: Todo[] = [
+  { id: '1', title: 'Write the spec', completed: false },
+  { id: '2', title: 'Ship the release', completed: true },
+  { id: '3', title: 'Review SPEC feedback', completed: true },
+];
+
+const todo = (title: string, completed = false): Todo => ({ id: 'x', title, completed });
+
+describe('matchesQuery', () => {
+  it('matches regardless of case', () => {
+    expect(matchesQuery(todo('Write the spec'), 'SPEC')).toBe(true);
+    expect(matchesQuery(todo('WRITE THE SPEC'), 'spec')).toBe(true);
+  });
+
+  it('matches anywhere in the title, not just the start', () => {
+    expect(matchesQuery(todo('Write the spec'), 'the')).toBe(true);
+  });
+
+  it('rejects titles that do not contain the query', () => {
+    expect(matchesQuery(todo('Write the spec'), 'invoice')).toBe(false);
+  });
+
+  it('treats an empty or whitespace-only query as no filter', () => {
+    expect(matchesQuery(todo('Write the spec'), '')).toBe(true);
+    expect(matchesQuery(todo('Write the spec'), '   ')).toBe(true);
+  });
+
+  it('ignores surrounding whitespace in the query', () => {
+    expect(matchesQuery(todo('Write the spec'), '  spec  ')).toBe(true);
+  });
+
+  it('ignores completion state', () => {
+    expect(matchesQuery(todo('Write the spec', true), 'spec')).toBe(true);
+  });
+});
+
+describe('matchesFilter', () => {
+  it('keeps everything for all', () => {
+    expect(matchesFilter(todo('a', false), 'all')).toBe(true);
+    expect(matchesFilter(todo('a', true), 'all')).toBe(true);
+  });
+
+  it('keeps only incomplete todos for active', () => {
+    expect(matchesFilter(todo('a', false), 'active')).toBe(true);
+    expect(matchesFilter(todo('a', true), 'active')).toBe(false);
+  });
+
+  it('keeps only completed todos for completed', () => {
+    expect(matchesFilter(todo('a', true), 'completed')).toBe(true);
+    expect(matchesFilter(todo('a', false), 'completed')).toBe(false);
+  });
+});
+
+describe('selectVisibleTodos', () => {
+  it('applies the query and the status filter together', () => {
+    const visible = selectVisibleTodos(todos, 'completed', 'spec');
+
+    expect(visible.map((item) => item.id)).toEqual(['3']);
+  });
+
+  it('falls back to the status filter alone when there is no query', () => {
+    const visible = selectVisibleTodos(todos, 'active', '');
+
+    expect(visible.map((item) => item.id)).toEqual(['1']);
+  });
+
+  it('searches across every status when the filter is all', () => {
+    const visible = selectVisibleTodos(todos, 'all', 'spec');
+
+    expect(visible.map((item) => item.id)).toEqual(['1', '3']);
+  });
+
+  it('returns nothing when the two filters have no overlap', () => {
+    expect(selectVisibleTodos(todos, 'active', 'release')).toEqual([]);
+  });
+
+  it('preserves the source order and does not mutate the input', () => {
+    const snapshot = todos.map((item) => ({ ...item }));
+
+    const visible = selectVisibleTodos(todos, 'all', 'e');
+
+    expect(visible.map((item) => item.id)).toEqual(['1', '2', '3']);
+    expect(todos).toEqual(snapshot);
+  });
+});
