 export function formatCount(count: number, noun: string): string {
-  return `${count} ${noun}${count === 1 ? '' : 's'}`;
+  if (count === 1) {
+    return `${count} ${noun}`;
+  }
+  
+  if (noun.endsWith('ch') || noun.endsWith('sh') || noun.endsWith('ss') || noun.endsWith('x') || noun.endsWith('z')) {
+    return `${count} ${noun}es`;
+  }
+  
+  return `${count} ${noun}s`;
 }
diff --git a/src/utils/match.test.ts b/src/utils/match.test.ts
new file mode 100644
index 0000000..6e9feb7
--- /dev/null
+++ b/src/utils/match.test.ts
@@ -0,0 +1,44 @@
+import { describe, expect, it } from 'vitest';
+import { matchesTodo } from './match';
+import type { Todo } from '../types';
+
+describe('matchesTodo', () => {
+  const todo: Todo = {
+    id: '1',
+    title: 'Write the Spec',
+    completed: false,
+  };
+
+  it('matches when query is empty', () => {
+    expect(matchesTodo(todo, '')).toBe(true);
+  });
+
+  it('matches case-insensitively', () => {
+    expect(matchesTodo(todo, 'write')).toBe(true);
+    expect(matchesTodo(todo, 'WRITE')).toBe(true);
+    expect(matchesTodo(todo, 'WrItE')).toBe(true);
+  });
+
+  it('matches partial strings', () => {
+    expect(matchesTodo(todo, 'spec')).toBe(true);
+    expect(matchesTodo(todo, 'the')).toBe(true);
+    expect(matchesTodo(todo, 'rite the sp')).toBe(true);
+  });
+
+  it('does not match when query is not found', () => {
+    expect(matchesTodo(todo, 'release')).toBe(false);
+    expect(matchesTodo(todo, 'xyz')).toBe(false);
+  });
+
+  it('handles todos with lowercase titles', () => {
+    const lowercaseTodo: Todo = { id: '2', title: 'ship the release', completed: false };
+    expect(matchesTodo(lowercaseTodo, 'Ship')).toBe(true);
+    expect(matchesTodo(lowercaseTodo, 'RELEASE')).toBe(true);
+  });
+
+  it('handles todos with uppercase titles', () => {
+    const uppercaseTodo: Todo = { id: '3', title: 'URGENT TASK', completed: false };
+    expect(matchesTodo(uppercaseTodo, 'urgent')).toBe(true);
+    expect(matchesTodo(uppercaseTodo, 'task')).toBe(true);
+  });
+});
diff --git a/src/utils/match.ts b/src/utils/match.ts
new file mode 100644
index 0000000..8ebd354
--- /dev/null
+++ b/src/utils/match.ts
@@ -0,0 +1,6 @@
+import type { Todo } from '../types';
+
+export function matchesTodo(todo: Todo, query: string): boolean {
+  if (!query) return true;
+  return todo.title.toLowerCase().includes(query.toLowerCase());
+}
