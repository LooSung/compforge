diff --git a/src/utils/match.test.ts b/src/utils/match.test.ts
new file mode 100644
index 0000000..8ed3d52
--- /dev/null
+++ b/src/utils/match.test.ts
@@ -0,0 +1,36 @@
+import { describe, expect, it } from 'vitest';
+import { matchesTodo } from './match';
+import type { Todo } from '../types';
+
+describe('matchesTodo', () => {
+  const todo: Todo = {
+    id: '1',
+    title: 'Buy groceries',
+    completed: false,
+  };
+
+  it('matches when query is empty', () => {
+    expect(matchesTodo(todo, '')).toBe(true);
+  });
+
+  it('matches when query is whitespace only', () => {
+    expect(matchesTodo(todo, '   ')).toBe(true);
+  });
+
+  it('matches when query is found case-insensitively', () => {
+    expect(matchesTodo(todo, 'buy')).toBe(true);
+    expect(matchesTodo(todo, 'BUY')).toBe(true);
+    expect(matchesTodo(todo, 'GROCERIES')).toBe(true);
+    expect(matchesTodo(todo, 'groc')).toBe(true);
+  });
+
+  it('does not match when query is not found', () => {
+    expect(matchesTodo(todo, 'milk')).toBe(false);
+    expect(matchesTodo(todo, 'xyz')).toBe(false);
+  });
+
+  it('matches partial words', () => {
+    expect(matchesTodo(todo, 'grocer')).toBe(true);
+    expect(matchesTodo(todo, 'eries')).toBe(true);
+  });
+});
diff --git a/src/utils/match.ts b/src/utils/match.ts
new file mode 100644
index 0000000..4f9529c
--- /dev/null
+++ b/src/utils/match.ts
@@ -0,0 +1,6 @@
+import type { Todo } from '../types';
+
+export function matchesTodo(todo: Todo, query: string): boolean {
+  if (query.trim() === '') return true;
+  return todo.title.toLowerCase().includes(query.toLowerCase());
+}
