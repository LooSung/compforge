+++ b/src/utils/search.test.ts
@@ -0,0 +1,49 @@
+import { describe, expect, it } from 'vitest';
+import type { Todo } from '../types';
+import { searchTodos } from './search';
+
+const todos: Todo[] = [
+  { id: '1', title: 'Write the spec', completed: false },
+  { id: '2', title: 'WRITE the release notes', completed: true },
+  { id: '3', title: 'Book the venue', completed: false },
+];
+
+const ids = (matches: Todo[]) => matches.map((todo) => todo.id);
+
+describe('searchTodos', () => {
+  it('matches the title regardless of case', () => {
+    expect(ids(searchTodos(todos, 'write'))).toEqual(['1', '2']);
+    expect(ids(searchTodos(todos, 'WRITE'))).toEqual(['1', '2']);
+    expect(ids(searchTodos(todos, 'WrItE'))).toEqual(['1', '2']);
+  });
+
+  it('matches any part of the title, not just the start', () => {
+    expect(ids(searchTodos(todos, 'venue'))).toEqual(['3']);
+    expect(ids(searchTodos(todos, 'the '))).toEqual(['1', '2', '3']);
+  });
+
+  it('returns every todo for an empty or whitespace-only query', () => {
+    expect(searchTodos(todos, '')).toEqual(todos);
+    expect(searchTodos(todos, '   ')).toEqual(todos);
+  });
+
+  it('ignores whitespace around the query', () => {
+    expect(ids(searchTodos(todos, '  spec  '))).toEqual(['1']);
+  });
+
+  it('returns nothing when no title matches', () => {
+    expect(searchTodos(todos, 'invoice')).toEqual([]);
+  });
+
+  it('matches completed and active todos alike', () => {
+    expect(ids(searchTodos(todos, 'release'))).toEqual(['2']);
+  });
+
+  it('keeps the original order and does not mutate the input', () => {
+    const before = structuredClone(todos);
+
+    expect(ids(searchTodos(todos, 'e'))).toEqual(['1', '2', '3']);
+
+    expect(todos).toEqual(before);
+  });
+});
