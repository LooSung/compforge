@@ -0,0 +1,34 @@
+import { formatCount } from '../utils/format';
+
+interface TodoSearchProps {
+  query: string;
+  matchCount: number;
+  canCompleteMatches: boolean;
+  onQueryChange: (query: string) => void;
+  onCompleteMatches: () => void;
+}
+
+export function TodoSearch({
+  query,
+  matchCount,
+  canCompleteMatches,
+  onQueryChange,
+  onCompleteMatches,
+}: TodoSearchProps) {
+  return (
+    <div className="todo-search">
+      <label htmlFor="search-todos">Search todos</label>
+      <input
+        id="search-todos"
+        type="search"
+        value={query}
+        onChange={(event) => onQueryChange(event.target.value)}
+        placeholder="Search by title"
+      />
+      <button type="button" disabled={!canCompleteMatches} onClick={onCompleteMatches}>
+        Complete all matches
+      </button>
+      <p role="status">{formatCount(matchCount, 'matching todo')}</p>
+    </div>
+  );
+}
