+import { act, renderHook } from '@testing-library/react';
+import { describe, expect, it } from 'vitest';
+import { useUrlSearchParam } from './useUrlSearchParam';
+
+describe('useUrlSearchParam', () => {
+  it('is empty when the param is absent', () => {
+    const { result } = renderHook(() => useUrlSearchParam('q'));
+
+    expect(result.current.value).toBe('');
+  });
+
+  it('reads the value already in the URL', () => {
+    window.history.replaceState(null, '', '?q=spec');
+
+    const { result } = renderHook(() => useUrlSearchParam('q'));
+
+    expect(result.current.value).toBe('spec');
+  });
+
+  it('writes the value to the URL without adding a history entry', () => {
+    const { result } = renderHook(() => useUrlSearchParam('q'));
+    const entriesBefore = window.history.length;
+
+    act(() => result.current.setValue('book the venue'));
+
+    expect(window.location.search).toBe('?q=book+the+venue');
+    expect(result.current.value).toBe('book the venue');
+    expect(window.history.length).toBe(entriesBefore);
+  });
+
+  it('drops the param when the value is cleared and leaves other params alone', () => {
+    window.history.replaceState(null, '', '?q=spec&sort=oldest');
+    const { result } = renderHook(() => useUrlSearchParam('q'));
+
+    act(() => result.current.setValue(''));
+
+    expect(window.location.search).toBe('?sort=oldest');
+    expect(result.current.value).toBe('');
+  });
+
+  it('follows browser navigation', () => {
+    const { result } = renderHook(() => useUrlSearchParam('q'));
+
+    act(() => {
+      window.history.replaceState(null, '', '?q=venue');
+      window.dispatchEvent(new PopStateEvent('popstate'));
+    });
+
+    expect(result.current.value).toBe('venue');
+  });
+});
diff --git a/src/hooks/useUrlSearchParam.ts b/src/hooks/useUrlSearchParam.ts
new file mode 100644
index 0000000..e550b7a
--- /dev/null
+++ b/src/hooks/useUrlSearchParam.ts
@@ -0,0 +1,47 @@
+import { useCallback, useSyncExternalStore } from 'react';
+
+export interface UrlSearchParam {
+  value: string;
+  setValue: (next: string) => void;
+}
+
+const listeners = new Set<() => void>();
+
+function subscribe(onStoreChange: () => void) {
+  listeners.add(onStoreChange);
+  window.addEventListener('popstate', onStoreChange);
+  return () => {
+    listeners.delete(onStoreChange);
+    window.removeEventListener('popstate', onStoreChange);
+  };
+}
+
+function readParam(key: string): string {
+  return new URLSearchParams(window.location.search).get(key) ?? '';
+}
+
+/**
+ * Reads and writes one URL search param as React state.
+ * Writes use replaceState so a per-keystroke value does not fill the back button.
+ */
+export function useUrlSearchParam(key: string): UrlSearchParam {
+  const value = useSyncExternalStore(subscribe, () => readParam(key));
+
+  const setValue = useCallback(
+    (next: string) => {
+      const params = new URLSearchParams(window.location.search);
+      if (next) {
+        params.set(key, next);
+      } else {
+        params.delete(key);
+      }
+      const search = params.toString();
+      const url = `${window.location.pathname}${search ? `?${search}` : ''}${window.location.hash}`;
+      window.history.replaceState(window.history.state, '', url);
+      for (const listener of listeners) listener();
+    },
+    [key],
+  );
+
+  return { value, setValue };
+}
diff --git a/src/utils/search.test.ts b/src/utils/search.test.ts
