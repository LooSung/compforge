@@ -0,0 +1,87 @@
+import { describe, expect, it } from 'vitest';
+import type { Todo } from '../types';
+import { matchesQuery, matchesStatus, selectTodos } from './search';
+
+const todos: Todo[] = [
+  { id: '1', title: 'Write the spec', completed: false },
+  { id: '2', title: 'Ship the release', completed: true },
+  { id: '3', title: 'Review the SPEC draft', completed: true },
+];
+
+const titles = (result: Todo[]) => result.map((todo) => todo.title);
+
+describe('matchesQuery', () => {
+  it('matches any todo when the query is blank', () => {
+    expect(matchesQuery(todos[0], '')).toBe(true);
+    expect(matchesQuery(todos[0], '   ')).toBe(true);
+  });
+
+  it('matches a substring of the title', () => {
+    expect(matchesQuery(todos[0], 'the spec')).toBe(true);
+    expect(matchesQuery(todos[0], 'spec')).toBe(true);
+  });
+
+  it('ignores case on both sides', () => {
+    expect(matchesQuery(todos[2], 'spec')).toBe(true);
+    expect(matchesQuery(todos[0], 'SPEC')).toBe(true);
+  });
+
+  it('ignores surrounding whitespace in the query', () => {
+    expect(matchesQuery(todos[0], '  spec  ')).toBe(true);
+  });
+
+  it('rejects titles that do not contain the query', () => {
+    expect(matchesQuery(todos[0], 'release')).toBe(false);
+  });
+
+  it('does not match on fields other than the title', () => {
+    expect(matchesQuery(todos[0], '1')).toBe(false);
+  });
+});
+
+describe('matchesStatus', () => {
+  it('accepts everything for "all"', () => {
+    expect(matchesStatus(todos[0], 'all')).toBe(true);
+    expect(matchesStatus(todos[1], 'all')).toBe(true);
+  });
+
+  it('splits active and completed todos', () => {
+    expect(matchesStatus(todos[0], 'active')).toBe(true);
+    expect(matchesStatus(todos[1], 'active')).toBe(false);
+    expect(matchesStatus(todos[1], 'completed')).toBe(true);
+    expect(matchesStatus(todos[0], 'completed')).toBe(false);
+  });
+});
+
+describe('selectTodos', () => {
+  it('returns every todo when the filter is "all" and the query is blank', () => {
+    expect(selectTodos(todos, 'all', '')).toHaveLength(3);
+  });
+
+  it('combines the query with the status filter', () => {
+    expect(titles(selectTodos(todos, 'all', 'spec'))).toEqual([
+      'Write the spec',
+      'Review the SPEC draft',
+    ]);
+    expect(titles(selectTodos(todos, 'active', 'spec'))).toEqual([
+      'Write the spec',
+    ]);
+    expect(titles(selectTodos(todos, 'completed', 'spec'))).toEqual([
+      'Review the SPEC draft',
+    ]);
+  });
+
+  it('returns nothing when the query matches no title', () => {
+    expect(selectTodos(todos, 'all', 'nonexistent')).toEqual([]);
+  });
+
+  it('preserves the original order and does not mutate the input', () => {
+    const snapshot = [...todos];
+    expect(titles(selectTodos(todos, 'all', 'the'))).toEqual([
+      'Write the spec',
+      'Ship the release',
+      'Review the SPEC draft',
+    ]);
+    expect(todos).toEqual(snapshot);
+  });
+});
diff --git a/src/utils/search.ts b/src/utils/search.ts
