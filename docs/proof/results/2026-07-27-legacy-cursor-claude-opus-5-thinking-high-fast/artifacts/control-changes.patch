+import { describe, expect, it } from 'vitest';
+import { readQueryParam, writeQueryParam } from './url';
+
+describe('readQueryParam', () => {
+  it('returns an empty string when the param is absent', () => {
+    expect(readQueryParam('')).toBe('');
+    expect(readQueryParam('?filter=active')).toBe('');
+  });
+
+  it('reads and decodes the query', () => {
+    expect(readQueryParam('?q=spec')).toBe('spec');
+    expect(readQueryParam('?q=the%20spec')).toBe('the spec');
+  });
+});
+
+describe('writeQueryParam', () => {
+  it('adds the query to the search string', () => {
+    expect(writeQueryParam('', 'spec')).toBe('?q=spec');
+  });
+
+  it('removes the param for a blank query', () => {
+    expect(writeQueryParam('?q=spec', '')).toBe('');
+    expect(writeQueryParam('?q=spec', '   ')).toBe('');
+  });
+
+  it('keeps unrelated params intact', () => {
+    expect(writeQueryParam('?filter=active', 'spec')).toBe(
+      '?filter=active&q=spec',
+    );
+    expect(writeQueryParam('?filter=active&q=spec', '')).toBe('?filter=active');
+  });
+
+  it('round-trips through readQueryParam', () => {
+    expect(readQueryParam(writeQueryParam('', 'The Spec'))).toBe('The Spec');
+  });
+});
