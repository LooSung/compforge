index 0000000..3dc3b29
--- /dev/null
+++ b/src/utils/search.ts
@@ -0,0 +1,31 @@
+import type { Todo } from '../types';
+
+export const STATUS_FILTERS = ['all', 'active', 'completed'] as const;
+
+export type StatusFilter = (typeof STATUS_FILTERS)[number];
+
+export function normalizeQuery(query: string): string {
+  return query.trim().toLowerCase();
+}
+
+export function matchesQuery(todo: Todo, query: string): boolean {
+  const needle = normalizeQuery(query);
+  if (needle === '') return true;
+  return todo.title.toLowerCase().includes(needle);
+}
+
+export function matchesStatus(todo: Todo, status: StatusFilter): boolean {
+  if (status === 'active') return !todo.completed;
+  if (status === 'completed') return todo.completed;
+  return true;
+}
+
+export function selectTodos(
+  todos: Todo[],
+  status: StatusFilter,
+  query: string,
+): Todo[] {
+  return todos.filter(
+    (todo) => matchesStatus(todo, status) && matchesQuery(todo, query),
+  );
+}
